# Copy to .env at the repository root before `docker compose up`:
#   cp .env.docker .env
#
# Generate each secret separately with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=ar_menu
POSTGRES_PASSWORD=
POSTGRES_DB=ar_menu

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=

# Number of reverse proxies in front of the API. 0 for plain compose; 1 behind
# a single load balancer. Too high a value lets clients forge their IP and
# bypass rate limiting.
TRUST_PROXY_HOPS=0

# ── Authentication (required — two different values) ──────────────────────────
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
ALLOW_REGISTRATION=true

# ── Cloudflare R2 (optional — uploads are disabled without it) ────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
STORAGE_QUOTA_BYTES=2147483648

# Hostname serving uploaded media, if you put a custom domain in front of R2.
# Leave blank when using the default *.r2.dev URL.
NEXT_PUBLIC_MEDIA_HOSTNAME=
