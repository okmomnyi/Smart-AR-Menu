# Public API base URL, used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of this app. Used for QR code targets, canonical links and OG tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hostname serving uploaded media, if you front Cloudflare R2 with a custom
# domain. Leave blank when using the default *.r2.dev URL — that is already
# allowed in next.config.js.
NEXT_PUBLIC_MEDIA_HOSTNAME=

# Server-side API URL for SSR and metadata. Only needed when the server reaches
# the API at a different address than the browser does (for example inside
# Docker, where it is http://backend:4000). Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
