# ── Database ──────────────────────────────────────────────────────────────────
# Application queries. On Neon use the POOLED endpoint (the -pooler host).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Prisma Migrate only. Must be the DIRECT endpoint — the same host with
# "-pooler" removed. Migrations need session state and advisory locks that
# pgbouncer transaction pooling throws away.
# For a plain local Postgres, set this to the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# Set to /api when the API is served at a path on the web app's hostname, for
# example https://menu.example.com/api. Leave empty when it has its own hostname.
API_PATH_PREFIX=
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
# Extra browser origins allowed to call this API (comma separated, optional)
ALLOWED_ORIGINS=""

# Number of reverse proxies in front of the API. Railway/Render/Fly = 1.
# Never set this higher than the real hop count: each trusted hop is one more
# X-Forwarded-For entry a client can forge to defeat rate limiting.
TRUST_PROXY_HOPS=0

# ── Authentication ────────────────────────────────────────────────────────────
# Two DIFFERENT random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET="replace-me-with-48-random-bytes-minimum-32-chars"
REFRESH_TOKEN_SECRET="replace-me-with-a-different-48-random-bytes-value"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Set to false to run the platform invite-only (no public sign-up).
ALLOW_REGISTRATION=true

# ── Cloudflare R2 storage (images and .glb models) ────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public bucket URL, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=""

# Per-restaurant storage ceiling in bytes (default 2 GiB) and per-file limits.
STORAGE_QUOTA_BYTES=2147483648
MAX_IMAGE_BYTES=10485760
MAX_MODEL_BYTES=41943040

# ── Seed (development only) ───────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@goldenfork.test"
# Leave unset to have the seed generate and print one.
SEED_ADMIN_PASSWORD=""
