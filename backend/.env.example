# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/ar_menu"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL="https://yourdomain.com"
# Comma-separated list of additional allowed CORS origins (optional)
ALLOWED_ORIGINS="https://yourdomain.com,https://admin.yourdomain.com"

# ── Firebase Auth (required for admin login) ──────────────────────────────────
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com"

# ── Cloudflare R2 Storage (required for image/model uploads) ──────────────────
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_bucket_name"
# Public URL for your R2 bucket (enable public access in Cloudflare dashboard)
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
