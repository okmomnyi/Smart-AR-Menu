# Copy to deploy/.env on the server. Never commit the real file.

# Hostname the tunnel serves, without https://.
APP_HOST=menu.kelvinmomanyi.me

# Image tag from the build workflow: sha-<full commit hash>, or latest.
IMAGE_TAG=latest

# Neon, same region as the server. Pooled endpoint for the app, direct endpoint
# (the same host without -pooler) for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Only for running Postgres on the server instead: remove both URLs above and
# set COMPOSE_PROFILES=local-db.
POSTGRES_USER=ar_menu
POSTGRES_DB=ar_menu
# openssl rand -hex 32
POSTGRES_PASSWORD=

# Two different values: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# true lets anyone create a restaurant account. false runs invite-only.
ALLOW_REGISTRATION=true

# Uploads stay disabled until all five are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Where uploaded files are served from. The API's media route needs no public
# bucket and no bucket CORS rules, and keeps models on the site's own origin:
R2_PUBLIC_URL=https://menu.kelvinmomanyi.me/api/media
# To serve straight from a public bucket instead, use its URL, for example
# https://pub-xxxx.r2.dev, and allow this site in the bucket's CORS rules.
STORAGE_QUOTA_BYTES=2147483648
